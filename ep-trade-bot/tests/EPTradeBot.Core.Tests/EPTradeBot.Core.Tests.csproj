<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EPTradeBot.Core\EPTradeBot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared risk contract, read from OpenAlgo in place so it cannot drift. -->
    <Content Include="..\..\..\test\risk\vectors.json" Link="Risk\vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Indicator values recorded from openalgo.ta (tools/contract-fixtures/record_indicators.py). -->
    <None Include="..\..\tools\contract-fixtures\indicators.fixtures.json" Link="Fixtures\indicators.fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Flow engine's behaviour recorded from OpenAlgo's services (tools/contract-fixtures/record_flow.py). -->
    <None Include="..\..\tools\contract-fixtures\flow.fixtures.json" Link="Fixtures\flow.fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Black-76 price, Greeks and implied volatility recorded from opengreeks (tools/contract-fixtures/record_black76.py). -->
    <None Include="..\..\tools\contract-fixtures\black76.fixtures.json" Link="Fixtures\black76.fixtures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
